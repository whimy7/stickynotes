<Application x:Class="StickyNotes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StickyNotes.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <converters:BooleanToDisplayActionConverter x:Key="BooleanToDisplayActionConverter" />
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter" />
        <converters:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibilityConverter" />
        <converters:ImagePathToThumbnailConverter x:Key="ImagePathToThumbnailConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Application.Resources>
</Application>
