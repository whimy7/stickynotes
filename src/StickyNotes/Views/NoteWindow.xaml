<Window x:Class="StickyNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="340"
        Height="360"
        MinWidth="240"
        MinHeight="180"
        MaxWidth="900"
        MaxHeight="1000"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Title="{Binding DisplayTitle}"
        Topmost="{Binding IsTopmost, Mode=TwoWay}"
        Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_Drop"
        FontFamily="Microsoft YaHei UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5C5A48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5C5A48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3A000000" />
                                <Setter Property="Foreground" Value="#232218" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="Foreground" Value="#4F514D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ImageButtonBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ImageButtonBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageOverlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OverlayButtonBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OverlayButtonBorder" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" BorderBrush="#806F682F" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#10000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="{Binding DisplayTitle}" Margin="10,0,4,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#454331" TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource TitleIconButtonStyle}" Click="AddImage_Click" ToolTip="在正文插入图片" AutomationProperties.Name="插入图片">
                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button x:Name="UndoButton" Grid.Column="2" Style="{StaticResource TitleIconButtonStyle}" Click="Undo_Click" ToolTip="撤销" AutomationProperties.Name="撤销">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button x:Name="RedoButton" Grid.Column="3" Style="{StaticResource TitleIconButtonStyle}" Click="Redo_Click" ToolTip="重做" AutomationProperties.Name="重做">
                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TitleIconButtonStyle}" Click="Color_Click" ToolTip="更换颜色" AutomationProperties.Name="更换颜色">
                    <TextBlock Text="&#xE2B1;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </Button>
                <ToggleButton Grid.Column="5" Style="{StaticResource PinButtonStyle}" IsChecked="{Binding IsTopmost, Mode=TwoWay}" ToolTip="始终置顶" AutomationProperties.Name="始终置顶">
                    <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                </ToggleButton>
                <Button Grid.Column="6" Style="{StaticResource TitleIconButtonStyle}" Click="Minimize_Click" ToolTip="最小化便签" AutomationProperties.Name="最小化便签">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                </Button>
                <Button Grid.Column="7" Style="{StaticResource TitleIconButtonStyle}" Click="Close_Click" ToolTip="隐藏便签" Margin="1,0,4,0" AutomationProperties.Name="隐藏便签">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="DocumentScroller"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          Padding="0,8,0,18">
                <ItemsControl x:Name="DocumentItems"
                              ItemsSource="{Binding DocumentBlocks}"
                              MinHeight="120"
                              Background="Transparent"
                              PreviewMouseLeftButtonDown="DocumentItems_PreviewMouseLeftButtonDown">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding}" AllowDrop="True">
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="#302F25"
                                         FontSize="16"
                                         MinHeight="38"
                                         Padding="14,3,14,3"
                                         SelectionBrush="#70665E38"
                                         CaretBrush="#302F25"
                                         GotKeyboardFocus="TextBlock_GotKeyboardFocus"
                                         SelectionChanged="TextBlock_SelectionChanged"
                                         PreviewKeyDown="TextBlock_PreviewKeyDown"
                                         AutomationProperties.Name="正文文本" />

                                <Grid x:Name="ImageEditor"
                                      Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="14,7,14,7"
                                      HorizontalAlignment="Left">
                                    <Border x:Name="ImageFrame"
                                            Width="{Binding ImageWidth}"
                                            MaxWidth="{Binding ActualWidth, ElementName=DocumentItems}"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToThumbnailConverter}}"
                                                   Stretch="Uniform"
                                                   MaxHeight="520"
                                                   AutomationProperties.Name="正文图片" />
                                            <Border x:Name="ImageToolbar"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="2"
                                                    Background="#D92B2B27"
                                                    CornerRadius="4"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource ImageOverlayButtonStyle}"
                                                            Cursor="SizeAll"
                                                            ToolTip="拖动图片"
                                                            PreviewMouseLeftButtonDown="ImageDragHandle_MouseLeftButtonDown"
                                                            PreviewMouseMove="ImageDragHandle_MouseMove"
                                                            AutomationProperties.Name="拖动图片">
                                                        <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource ImageOverlayButtonStyle}" Tag="{Binding}" CommandParameter="-40" Click="ResizeImage_Click" ToolTip="缩小图片" AutomationProperties.Name="缩小图片">
                                                        <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource ImageOverlayButtonStyle}" Tag="{Binding}" CommandParameter="40" Click="ResizeImage_Click" ToolTip="放大图片" AutomationProperties.Name="放大图片">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource ImageOverlayButtonStyle}" Tag="{Binding}" Click="OpenImage_Click" ToolTip="打开原图" AutomationProperties.Name="打开原图">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                    </Button>
                                                    <Button Style="{StaticResource ImageOverlayButtonStyle}" Tag="{Binding}" Click="DeleteImage_Click" ToolTip="删除图片" AutomationProperties.Name="删除图片">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="ImageResizeHandle"
                                            Style="{StaticResource ImageIconButtonStyle}"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,-5,-5"
                                            Opacity="0"
                                            IsHitTestVisible="False"
                                            Cursor="SizeNWSE"
                                            Tag="{Binding}"
                                            ToolTip="拖动调整图片大小"
                                            PreviewMouseLeftButtonDown="ImageResize_MouseLeftButtonDown"
                                            PreviewMouseMove="ImageResize_MouseMove"
                                            PreviewMouseLeftButtonUp="ImageResize_MouseLeftButtonUp"
                                            LostMouseCapture="ImageResize_LostMouseCapture"
                                            AutomationProperties.Name="调整图片大小">
                                        <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="#55574F" />
                                    </Button>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="ImageEditor" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ImageFrame" Property="BorderBrush" Value="#70000000" />
                                    <Setter TargetName="ImageToolbar" Property="Opacity" Value="1" />
                                    <Setter TargetName="ImageToolbar" Property="IsHitTestVisible" Value="True" />
                                    <Setter TargetName="ImageResizeHandle" Property="Opacity" Value="1" />
                                    <Setter TargetName="ImageResizeHandle" Property="IsHitTestVisible" Value="True" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
